{
  "version": 1,
  "defaults": {
    "build": [
      "android"
    ],
    "check": [
      "host"
    ]
  },
  "runners": {
    "wsl": {
      "preset": "boltpocket-opencl-android",
      "env": {
        "EXPO_PUBLIC_BOLTPOCKET_LOCAL_ONLY": "1",
        "BOLT_VULKAN": "0",
        "BOLTPOCKET_ANDROID_ABIS": "arm64-v8a",
        "BOLTPOCKET_BUILD_JOBS": "6",
        "EXPO_NO_TELEMETRY": "1",
        "CI": "1",
        "BOLT_OPENCL": "1"
      },
      "prepare": [
        {
          "name": "pnpm",
          "for": [
            "build",
            "check",
            "deps",
            "native"
          ],
          "inputs": [
            "package.json",
            "**/package.json",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "patches/*"
          ],
          "outputs": [
            "node_modules/.modules.yaml"
          ],
          "argv": [
            "pnpm",
            "install",
            "--frozen-lockfile"
          ]
        },
        {
          "name": "ssh-android",
          "for": [
            "build",
            "native"
          ],
          "inputs": [
            "packages/expo-ssh/scripts/build-android-dependencies.sh",
            "packages/expo-ssh/android/src/main/c/**"
          ],
          "outputs": [
            "packages/expo-ssh/android/src/main/jniLibs/arm64-v8a/libboltpocket_ssh.so"
          ],
          "argv": [
            "bash",
            "packages/expo-ssh/scripts/build-android-dependencies.sh"
          ]
        },
        {
          "name": "bolt-android",
          "for": [
            "build",
            "native"
          ],
          "inputs": [
            "packages/expo-bolt-runtime/cpp/**",
            "tools/bolt/build_native.py"
          ],
          "outputs": [
            "packages/expo-bolt-runtime/android/src/main/jniLibs/arm64-v8a/libboltexpo.so"
          ],
          "argv": [
            "python3",
            "tools/bolt/build_native.py",
            "android"
          ]
        },
        {
          "name": "expo-android",
          "for": [
            "build"
          ],
          "inputs": [
            "app/app.json",
            "app/app.config.ts",
            "app/locales/**",
            "app/assets/boltpocket/**",
            "app/package.json",
            "packages/expo-bolt-runtime/expo-module.config.json",
            "packages/expo-bolt-runtime/android/build.gradle",
            "tools/bolt/prebuild.mjs"
          ],
          "outputs": [
            "app/android/gradlew"
          ],
          "argv": [
            "node",
            "tools/bolt/prebuild.mjs",
            "android"
          ]
        }
      ]
    }
  },
  "targets": {
    "host": {
      "runner": "wsl",
      "commands": {
        "deps": {
          "steps": [
            [
              "pnpm",
              "--version"
            ]
          ]
        },
        "check": {
          "steps": [
            [
              "pnpm",
              "check"
            ]
          ]
        }
      }
    },
    "android": {
      "runner": "wsl",
      "commands": {
        "build": {
          "steps": [
            [
              "pnpm",
              "check"
            ],
            {
              "cwd": "app/android",
              "argv": [
                "bash",
                "./gradlew",
                "--no-daemon",
                "--max-workers=2",
                ":app:assembleRelease",
                "-PreactNativeArchitectures=arm64-v8a"
              ]
            }
          ],
          "artifacts": [
            "app/android/app/build/outputs/apk/release/*.apk",
            "build/bolt-native-android/receipt.json",
            "build/bolt-native-android/libboltexpo.so"
          ]
        }
      }
    }
  }
}
