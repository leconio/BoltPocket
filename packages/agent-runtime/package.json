{
  "name": "@boltpocket/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check:model-capacities": "node scripts/generate-openai-model-capacities.mjs --check",
