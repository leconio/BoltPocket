{
  "name": "@boltpocket/expo-storefront-region",
  "version": "0.1.0",
  "description": "StoreKit storefront region bridge for BoltPocket distribution policy",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "react-native": "./src/policy.ts",
      "import": "./src/policy.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "expo-modules-core": "57.0.10"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo": "~57.0.12",
    "react-native": "0.86.2",
    "tsx": "4.23.5",
    "typescript": "~6.0.3"
  }
}
